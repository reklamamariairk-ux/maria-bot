# Получить у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# Ключ Groq API — https://console.groq.com/
GROQ_KEY=gsk_...

# Публичный URL вашего сервера (для webhook Telegram)
# На Render.com выглядит так: https://maria-bot.onrender.com
WEBHOOK_URL=https://your-app.onrender.com

# URL Mini App — обычно совпадает с WEBHOOK_URL
MINI_APP_URL=https://your-app.onrender.com

# Порт (Render подставляет автоматически)
PORT=3000

# ─── VK Mini App (всё опционально — без них работает TG-only режим) ─────────
# Создать приложение: vk.com/editapp?act=create (тип VK Mini App)
VK_APP_ID=
# editapp → Настройки → «Защищённый ключ»
VK_APP_SECRET=
# ID сообщества «Мария» (положительное число, без минуса)
VK_GROUP_ID=
# Сообщество → Управление → Работа с API → Ключи доступа (scope: messages)
VK_GROUP_TOKEN=
# Callback API: секрет и строка подтверждения (Управление → Работа с API → Callback API)
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
