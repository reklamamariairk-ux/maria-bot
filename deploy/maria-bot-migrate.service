[Unit]
Description=Maria Bot database migration
After=network-online.target postgresql.service pgbouncer.service
Wants=network-online.target

[Service]
Type=oneshot
User=maria
Group=maria
WorkingDirectory=/opt/maria-bot-current
EnvironmentFile=/opt/maria-bot-russia/.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node /opt/maria-bot-current/dist/migrate.js
NoNewPrivileges=true
ProtectSystem=full
